# Copy to .env before running `docker compose up`.
# Local development values only — use real secrets management in any deployed environment.
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=healthcare

# Optional. IANA timezone used for calendar dates in patient summaries.
PRACTICE_TIMEZONE=America/New_York

# Optional. Turns on generated summaries in the patient chart.
# Leave empty to use only the built-in summary. Never commit a real key.
# Generated summaries send note text to OpenAI; use synthetic data only.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=
